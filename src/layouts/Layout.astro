---
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import '../../style.css';
---

<!doctype html>
<html lang="en">

<head>
	<title>Oussama Bernou | Full-Stack Engineer</title>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content="Portfolio of Oussama Bernou, a full-stack engineer focused on product engineering, AI-powered tooling, and backend systems." />
	<style is:inline>
		:root {
			background-color: #ffffff;
			color-scheme: light;
		}

		@media (prefers-color-scheme: dark) {
			:root {
				background-color: #0e0e0e;
				color-scheme: dark;
			}
		}

		:root[data-theme='light'] {
			background-color: #ffffff;
			color-scheme: light;
		}

		:root[data-theme='dark'] {
			background-color: #0e0e0e;
			color-scheme: dark;
		}
	</style>
	<script is:inline>
		(() => {
			try {
				const storedTheme = localStorage.getItem('theme');
				const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.dataset.theme = storedTheme === 'light' || storedTheme === 'dark'
					? storedTheme
					: prefersDark
						? 'dark'
						: 'light';
			} catch {
				document.documentElement.dataset.theme = 'light';
			}
		})();
	</script>
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&display=swap" rel="stylesheet" />
	<link rel="icon" href="/images/favicon.png">
</head>

<body class="min-h-screen py-12 px-4 sm:px-8 lg:px-16 max-w-6xl mx-auto">
	<NavBar />
	<main>
		<slot />
	</main>
	<Footer />

	<script is:inline>
		(() => {
			if (typeof window === 'undefined') return;
			const w = window;

			const initTechBadges = () => {
				if (!('IntersectionObserver' in w)) {
					document.querySelectorAll('.tech-badge[data-animate]')
						.forEach((el) => el.classList.add('is-visible'));
					return;
				}

				if (!w.__techBadgeIO) {
					w.__techBadgeIO = new IntersectionObserver((entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								const el = entry.target;
								const delay = el.getAttribute('data-delay') || Math.floor(Math.random() * 220);
								el.style.setProperty('--reveal-delay', `${delay}ms`);
								el.classList.add('is-visible');
								w.__techBadgeIO.unobserve(el);
							}
						}
					}, { threshold: 0.15, rootMargin: '0px 0px -10% 0px' });
				}

				document.querySelectorAll('.tech-badge[data-animate]')
					.forEach((el) => w.__techBadgeIO.observe(el));
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initTechBadges);
			} else {
				initTechBadges();
			}
		})();
	</script>
	<script is:inline>
		(() => {
			if (typeof window === 'undefined') return;
			const contextApi = navigator.modelContext;
			if (!contextApi || typeof contextApi.provideContext !== 'function') return;

			const withOrigin = (path) => new URL(path, window.location.origin).toString();

			contextApi.provideContext({
				tools: [
					{
						name: 'open_page',
						description: 'Navigate to a public page on bernoussama.com.',
						inputSchema: {
							type: 'object',
							properties: {
								path: { type: 'string', description: 'Absolute site path such as /projects or /blog.' },
							},
							required: ['path'],
							additionalProperties: false,
						},
						execute: async ({ path }) => {
							const candidatePath = typeof path === 'string' ? path.trim() : '';
							const normalizedPath = candidatePath.toLowerCase();
							const isUnsafePath = typeof path !== 'string'
								|| !candidatePath.startsWith('/')
								|| candidatePath.startsWith('//')
								|| candidatePath.includes('://')
								|| normalizedPath.includes('%2f')
								|| normalizedPath.includes('%5c');
							if (isUnsafePath) {
								return { ok: false, error: 'path must be a safe same-origin absolute path starting with /' };
							}
							const destinationUrl = new URL(candidatePath, window.location.origin);
							if (destinationUrl.origin !== window.location.origin) {
								return { ok: false, error: 'path must resolve to the current site origin' };
							}
							const destination = destinationUrl.toString();
							window.location.assign(destination);
							return { ok: true, destination };
						},
					},
					{
						name: 'get_contact_card',
						description: 'Return the primary contact methods for the portfolio owner.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({
							name: 'Oussama Bernou',
							email: 'hello@bernoussama.com',
							contact_page: withOrigin('/contact'),
							linkedin: 'https://linkedin.com/in/oussama-bernou',
						}),
					},
					{
						name: 'list_featured_sections',
						description: 'List key website sections that agents can browse.',
						inputSchema: {
							type: 'object',
							properties: {},
							additionalProperties: false,
						},
						execute: async () => ({
							sections: [
								{ name: 'Home', path: withOrigin('/') },
								{ name: 'Projects', path: withOrigin('/projects') },
								{ name: 'Blog', path: withOrigin('/blog') },
								{ name: 'Resume', path: withOrigin('/resume') },
								{ name: 'Contact', path: withOrigin('/contact') },
							],
						}),
					},
				],
			});
		})();
	</script>

	<style is:global>
		.prose :where(code):not(:where([class~='not-prose'], [class~='not-prose'] *))::before,
		.prose :where(code):not(:where([class~='not-prose'], [class~='not-prose'] *))::after {
			content: none !important;
		}

		.prose pre.astro-code code {
			background-color: transparent !important;
			border-radius: 0 !important;
			padding: 0 !important;
			font-weight: inherit !important;
			font-size: inherit !important;
			font-family: inherit !important;
			color: inherit !important;
		}

		.prose pre.astro-code {
			border-radius: 0 !important;
			border: 1px solid rgb(var(--color-grid-border)) !important;
			border-left: 2px solid rgb(var(--color-on-surface-variant)) !important;
		}

		/* Only recolor blocks that ship both light and dark shiki themes. */
		[data-theme='light'] .prose pre.astro-code.astro-code-themes {
			background-color: rgb(var(--color-surface-lowest)) !important;
		}

		[data-theme='dark'] .prose pre.astro-code.astro-code-themes,
		[data-theme='dark'] .prose pre.astro-code.astro-code-themes span {
			color: var(--shiki-dark) !important;
			background-color: var(--shiki-dark-bg) !important;
			font-style: var(--shiki-dark-font-style) !important;
			font-weight: var(--shiki-dark-font-weight) !important;
			text-decoration: var(--shiki-dark-text-decoration) !important;
		}
	</style>
</body>

</html>
