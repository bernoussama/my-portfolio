---
import Layout from './Layout.astro';
import PageViews from '../components/PageViews.astro';
const { frontmatter } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---
<Layout>
  <section class="mb-12 border-b-2 border-black pb-6">
    <a href="/blog" class="hover:underline hover:text-blue-600 transition-colors inline-flex items-center gap-2 mb-8 font-medium">
      [ Back to Writing ]
    </a>
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-6">{frontmatter.title}</h1>
    <div class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400 font-mono">
      <span>{formattedDate}</span>
      <span>|</span>
      <PageViews url={pageUrl} />
    </div>
    <p class="mt-4 text-slate-600 dark:text-slate-400 text-lg leading-relaxed max-w-3xl">{frontmatter.description}</p>
  </section>

  <article class="max-w-4xl mx-auto py-6">
    <div class="post-content prose max-w-none prose-headings:font-bold prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  [data-theme='light'] .post-content,
  [data-theme='dark'] .post-content {
    --tw-prose-body: rgb(var(--color-fg));
    --tw-prose-headings: rgb(var(--color-fg));
    --tw-prose-lead: rgb(var(--color-on-surface-variant));
    --tw-prose-links: rgb(var(--color-fg));
    --tw-prose-bold: rgb(var(--color-fg));
    --tw-prose-counters: rgb(var(--color-on-surface-variant));
    --tw-prose-bullets: rgb(var(--color-on-surface-variant));
    --tw-prose-hr: rgb(var(--color-outline-variant));
    --tw-prose-quotes: rgb(var(--color-fg));
    --tw-prose-quote-borders: rgb(var(--color-outline-variant));
    --tw-prose-captions: rgb(var(--color-on-surface-variant));
    --tw-prose-kbd: rgb(var(--color-fg));
    --tw-prose-code: rgb(var(--color-fg));
    --tw-prose-th-borders: rgb(var(--color-outline-variant));
    --tw-prose-td-borders: rgb(var(--color-outline-variant));
    color: rgb(var(--color-fg));
  }

  .post-content :where(a):not(:where([class~='not-prose'], [class~='not-prose'] *)) {
    color: var(--border-color);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(37, 99, 235, 0.6);
    text-underline-offset: 4px;
  }

  .post-content :where(a:hover):not(:where([class~='not-prose'], [class~='not-prose'] *)) {
    color: #2563eb;
    text-decoration-color: #2563eb;
  }

  .post-content img {
    border: 2px solid #000000;
    border-radius: 8px;
    box-shadow: 4px 4px 0px 0px rgba(0,0,0,1);
    margin: 2rem auto;
  }
</style>
