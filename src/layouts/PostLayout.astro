---
import Layout from './Layout.astro';
import PageViews from '../components/PageViews.astro';
const { frontmatter } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---
<Layout>
  <section class="mb-12 border-b-2 border-black pb-6">
    <a href="/blog" class="hover:underline hover:text-blue-600 transition-colors inline-flex items-center gap-2 mb-8 font-medium">
      [ Back to Writing ]
    </a>
    <h1 class="text-3xl md:text-5xl font-bold tracking-tight leading-tight mb-6">{frontmatter.title}</h1>
    <div class="flex items-center gap-4 text-sm text-gray-500 font-mono">
      <span>{formattedDate}</span>
      <span>|</span>
      <PageViews url={pageUrl} />
    </div>
    <p class="mt-4 text-gray-700 text-lg leading-relaxed max-w-3xl">{frontmatter.description}</p>
  </section>

  <article class="max-w-4xl mx-auto py-6">
    <div class="post-content prose max-w-none prose-headings:font-bold prose-headings:text-black prose-p:text-gray-800 prose-strong:text-black prose-li:text-gray-800 prose-blockquote:text-gray-700 prose-code:text-black prose-code:bg-gray-100 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-hr:border-gray-300 prose-th:text-black prose-td:text-gray-800">
      <slot />
    </div>
  </article>
</Layout>

<style is:global>
  .post-content :where(a):not(:where([class~='not-prose'], [class~='not-prose'] *)) {
    color: #000000;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(37, 99, 235, 0.6);
    text-underline-offset: 4px;
  }

  .post-content :where(a:hover):not(:where([class~='not-prose'], [class~='not-prose'] *)) {
    color: #2563eb;
    text-decoration-color: #2563eb;
  }

  .post-content img {
    border: 2px solid #000000;
    border-radius: 8px;
    box-shadow: 4px 4px 0px 0px rgba(0,0,0,1);
    margin: 2rem auto;
  }
</style>
