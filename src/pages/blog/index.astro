---
import BlogPost from '../../components/BlogPost.astro';
import Layout from '../../layouts/Layout.astro';

interface BlogFrontmatter {
	title: string;
	description: string;
	pubDate?: string;
}

const allPosts = Object.entries(
	import.meta.glob<BlogFrontmatter>('./*.md', { eager: true, import: 'frontmatter' }),
)
	.map(([path, frontmatter]) => ({
		url: path.replace('./', '/blog/').replace(/\.md$/, ''),
		...frontmatter,
	}))
	.sort((a, b) => {
		const dateA = a.pubDate ? new Date(a.pubDate).getTime() : 0;
		const dateB = b.pubDate ? new Date(b.pubDate).getTime() : 0;
		return dateB - dateA;
	});
---

<Layout>
	<section class="mb-12 border-b-2 border-black pb-6">
		<a href="/" class="hover:underline hover:text-blue-600 transition-colors inline-flex items-center gap-2 mb-8 font-medium">
			[ Back to Home ]
		</a>
		<h1 class="text-4xl md:text-6xl font-bold tracking-tight mb-4">Writing</h1>
		<p class="text-gray-700 max-w-2xl text-base md:text-lg leading-relaxed">
			Thinking through systems, tradeoffs, and implementation details across full-stack and low-level work.
		</p>
	</section>
	
	<section class="mb-16">
		<div class="flex flex-col gap-4">
			{allPosts.map((post) => (
				<BlogPost url={post.url} title={post.title} description={post.description} pubDate={post.pubDate} />
			))}
		</div>
	</section>
</Layout>
