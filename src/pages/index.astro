---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../data/projects';

interface BlogFrontmatter {
	title: string;
	description: string;
	pubDate?: string;
	tags?: Array<string>;
}

const latestPosts = Object.entries(
	import.meta.glob<BlogFrontmatter>('./blog/*.md', { eager: true, import: 'frontmatter' }),
)
	.map(([path, frontmatter]) => ({
		url: path.replace('./blog/', '/blog/').replace(/\.md$/, ''),
		...frontmatter,
	}))
	.sort((a, b) => {
		const dateA = a.pubDate ? new Date(a.pubDate).getTime() : 0;
		const dateB = b.pubDate ? new Date(b.pubDate).getTime() : 0;
		return dateB - dateA;
	})
	.slice(0, 3);
---

<Layout>
	<!-- BEGIN: HeroSection -->
	<section class="mb-8">
		<p class="text-base mb-4 font-semibold">Hi,</p>
		<p class="text-base leading-relaxed mb-6">
			This is <span class="border-b-2 border-[var(--border-color)] font-bold">Oussama Bernou</span>, building end-to-end software across <span class="text-blue-500 font-bold">Go</span>, <span class="bg-blue-600 text-white px-1 rounded font-bold">Ts</span> / <span class="bg-yellow-400 text-black px-1 rounded font-bold">Js</span> and <span class="font-bold text-slate-600 dark:text-slate-400">Python</span>
		</p>
	</section>
	<!-- END: HeroSection -->

	<!-- BEGIN: InterestsSection -->
	<section class="mb-8">
		<h2 class="text-lg mb-4 font-bold">What I am into:</h2>
		<ul class="list-disc list-inside space-y-2 text-base  pl-4">
			<li>Product Engineering</li>
      <li>AI Engineering/Tooling</li>
      <li>AI Engineering/Tooling</li>
			<li>Web Servers &amp; APIs</li>
			<li>Distributed Systems</li>
		</ul>
	</section>
	<!-- END: InterestsSection -->

	<!-- BEGIN: InterestsSection -->
	<section class="mb-8">
		<h2 class="text-lg mb-4 font-bold">Highlights:</h2>
		<ul class="list-disc list-inside space-y-2 text-base  pl-4">
      <li>Built <a class="font-bold" href="https://github.com/bernoussama/lazyshell">Lazyshell</a> - AI-powered cli interpreting natral language to shell commands, that had 6000+ users</li>
      <li>Currently Building <a class="font-bold" href="https://clankeroverflow.com">Clankeroverflow</a> - Stopping agents from making the same mistakes</li>
      <li>Built <a class="font-bold" href="https://simplinvo.com">Simplinvo</a> - Invoicing app built to simplify and accelerate business workflows</li>
      <li>Building AI tools - <a class="font-bold" href="https://github.com/bernoussama/lazyshell">Lazyshell</a>, <a class="font-bold" href="https://github.com/bernoussama/context-tools">Context tools</a> <a class="font-bold" href="https://clankeroverflow.com">ClankerOverflow</a>...</li>
		</ul>
	</section>
	<!-- END: InterestsSection -->

	<!-- BEGIN: StatsSection -->
	<section class="mb-8">
		<p class="text-base leading-relaxed mb-4 max-w-4xl">
      Over the past few years built some awesome projects surrounding few topics like <span class="border-b-2 border-(--border-color) font-semibold">infrastructure, networking, and AI tooling</span>.
		</p>
	</section>
	<!-- END: StatsSection -->

	<!-- BEGIN: ProjectsSection -->
	<section>
		<h2 class="text-3xl md:text-4xl font-bold mb-10 tracking-tight">Projects</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			{featuredProjects.map((project, index) => (
				<ProjectCard 
					title={project.title}
					body={project.body}
					techs={project.techs}
					projectPage={project.projectPage}
					actions={project.actions}
					statusLabel={project.statusLabel}
					index={index}
				/>
			))}
		</div>
	</section>
	<!-- END: ProjectsSection -->

	<!-- BEGIN: WritingsSection -->
	<section class="mt-16">
		<h2 class="text-3xl md:text-4xl font-bold mb-10 tracking-tight">Writings</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			{latestPosts.map((post, index) => (
				<ProjectCard
					title={post.title}
					body={post.description}
					techs={post.tags?.slice(0, 4)}
					projectPage={post.url}
					category="Writing"
					buttonText="Read"
					hideSecondaryAction
					index={index}
				/>
			))}
		</div>
	</section>
	<!-- END: WritingsSection -->
</Layout>
