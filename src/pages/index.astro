---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../data/projects';
---

<Layout>
	<!-- BEGIN: HeroSection -->
	<section class="mb-16">
		<p class="text-base mb-4 font-semibold">Yoo,</p>
		<p class="text-base leading-relaxed mb-6">
			This is side <span class="border-b-2 border-[var(--border-color)] font-bold">Oussama Bernou</span>, I like to build cool stuffs using <span class="text-blue-600 font-bold">Go</span>, <span class="bg-blue-600 text-white px-1 rounded font-bold">Ts</span> / <span class="bg-yellow-400 text-black px-1 rounded font-bold">Js</span> and <span class="font-bold">Python</span>
		</p>
		<p class="text-base md:text-lg mb-8 leading-relaxed max-w-4xl">
			Building end-to-end software across React, TypeScript, Node.js, Go, and Rust. Direct, efficient, and focused on product systems that ship cleanly.
		</p>
	</section>
	<!-- END: HeroSection -->

	<!-- BEGIN: InterestsSection -->
	<section class="mb-16">
		<h2 class="text-lg mb-4 font-bold">What I am into :</h2>
		<ul class="list-disc list-inside space-y-2 text-base md:text-lg pl-4">
			<li>Product Engineering</li>
			<li>High Performance Software Systems</li>
			<li>AI Tooling</li>
			<li>Web Servers &amp;&amp; APIs</li>
			<li>Distributed Systems</li>
		</ul>
	</section>
	<!-- END: InterestsSection -->

	<!-- BEGIN: StatsSection -->
	<section class="mb-20">
		<p class="text-base md:text-lg leading-relaxed mb-4 max-w-4xl">
			Over the past few years built some awesome projects surrounding few topics like <span class="border-b-2 border-[var(--border-color)] font-semibold">infrastructure, observable metrics</span> which also got some traction on social media.
		</p>
		<p class="text-base md:text-lg font-medium">
			Extras : Focus: Product / Systems / AI Tooling, Stack: TypeScript / Go / Rust
		</p>
	</section>
	<!-- END: StatsSection -->

	<!-- BEGIN: ProjectsSection -->
	<section>
		<h2 class="text-3xl md:text-4xl font-bold mb-10 tracking-tight">Projects &amp; Paper Implementations</h2>
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			{featuredProjects.map((project, index) => (
				<ProjectCard 
					title={project.title}
					body={project.body}
					techs={project.techs}
					projectPage={project.projectPage}
					actions={project.actions}
					statusLabel={project.statusLabel}
					index={index}
				/>
			))}
		</div>
	</section>
	<!-- END: ProjectsSection -->
</Layout>
