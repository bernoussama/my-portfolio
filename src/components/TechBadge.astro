---
interface Props {
	iconLink?: string;
	name: string;
}
const { iconLink, name } = Astro.props;
---
<span class="bg-gray-100 px-2.5 py-1 text-xs rounded-sm font-semibold text-gray-800 font-mono inline-flex items-center gap-1.5 border border-gray-200">
	{iconLink && (
		<img src={iconLink} title={name} alt={name} width="14" height="14" class="inline-block" />
	)}
	<span>{name}</span>
</span>
