---
const { pathname } = Astro.url;

// Helper to determine active state of links
const isActive = (href: string) => {
	if (href === '/') {
		return pathname === '/';
	}
	return pathname.startsWith(href);
};
---

<header class="mb-16 flex flex-col md:flex-row justify-between items-start md:items-center border-b-2 border-black pb-4 gap-4">
	<div class="text-2xl font-bold tracking-tighter">
		<a href="/" class="hover:text-blue-600 transition-colors">[ Oussama Bernou ]</a>
	</div>
	<nav>
		<ul class="flex flex-wrap gap-4 sm:gap-6 text-sm font-medium">
			<li>
				<a 
					class={`hover:underline hover:text-blue-600 transition-colors ${isActive('/projects') ? 'text-blue-600 underline font-bold' : ''}`} 
					href="/projects"
				>
					[ Projects ]
				</a>
			</li>
			<li>
				<a 
					class={`hover:underline hover:text-blue-600 transition-colors ${isActive('/blog') ? 'text-blue-600 underline font-bold' : ''}`} 
					href="/blog"
				>
					[ Writing ]
				</a>
			</li>
			<li>
				<a 
					class={`hover:underline hover:text-blue-600 transition-colors ${isActive('/resume') ? 'text-blue-600 underline font-bold' : ''}`} 
					href="/resume"
				>
					[ About ]
				</a>
			</li>
			<li>
				<a 
					class={`hover:underline hover:text-blue-600 transition-colors ${isActive('/contact') ? 'text-blue-600 underline font-bold' : ''}`} 
					href="/contact"
				>
					[ Connect ]
				</a>
			</li>
		</ul>
	</nav>
</header>
