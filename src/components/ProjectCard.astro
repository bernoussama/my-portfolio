---
interface Props {
	src?: string;
	title: string;
	body?: string;
	href?: string;
	demoUrl?: string;
	techs?: Array<string>;
	buttonText?: string;
	projectPage?: string;
	actions?: Array<{
		label: string;
		href: string;
		external?: boolean;
		variant?: 'primary' | 'default';
	}>;
	statusLabel?: string;
	index?: number;
	category?: string;
	hideSecondaryAction?: boolean;
}

const { title, body, techs, projectPage, actions = [], category: propCategory, buttonText, hideSecondaryAction = false }: Props = Astro.props;

// Determine category
const category = propCategory ?? (() => {
	const t = title.toLowerCase();
	if (t.includes('clankeroverflow')) return 'AI Tooling';
	if (t.includes('simplinvo') || t.includes('netflix') || t.includes('yanc')) return 'Project';
	if (t.includes('lazyshell')) return 'AI Tooling';
	if (t.includes('context')) return 'Extension';
	if (t.includes('trustun') || t.includes('dns') || t.includes('http') || t.includes('vpn') || t.includes('server')) return 'Systems';
	if (t.includes('maze')) return 'Game';
	return 'Project';
})();

// Normalize action buttons to fit the dual-button layout
// We want exactly two buttons:
// 1. Live Demo / View Tweet / Details (Primary - Blue)
// 2. View Code / Github (Secondary - Black/Dark)
let primaryBtn = { label: 'No Demo', href: '#', enabled: false };
let secondaryBtn = { label: 'No Code', href: '#', enabled: false };

// Helper to look for actions
const githubAction = actions.find(a => a.label.toLowerCase().includes('github') || a.label.toLowerCase().includes('source') || a.label.toLowerCase().includes('code'));
const demoAction = actions.find(a => a.label.toLowerCase().includes('demo') || a.label.toLowerCase().includes('live'));
const detailsAction = actions.find(a => a.label.toLowerCase().includes('details') || a.label.toLowerCase().includes('view'));

// Configure primary (first) button
if (demoAction) {
	primaryBtn = { label: buttonText ? `${buttonText} →` : 'Live Demo →', href: demoAction.href, enabled: true };
} else if (detailsAction) {
	primaryBtn = { label: buttonText ? `${buttonText} →` : 'Details →', href: detailsAction.href, enabled: true };
} else if (projectPage) {
	primaryBtn = { label: buttonText ? `${buttonText} →` : 'Details →', href: projectPage, enabled: true };
} else {
		primaryBtn = { label: 'No Demo', href: '#', enabled: false };
}

// Configure secondary (second) button
if (githubAction) {
	secondaryBtn = { label: 'View Code →', href: githubAction.href, enabled: true };
} else {
	// Find any action that isn't the primary one
	const otherAction = actions.find(a => a.href !== primaryBtn.href);
	if (otherAction) {
		secondaryBtn = { label: `${otherAction.label} →`, href: otherAction.href, enabled: true };
	}
}
---

<article class="card-brutalist p-8 flex flex-col h-full" data-purpose="project-card">
	<div class="mb-4">
		<span class="text-xs font-bold uppercase tracking-widest text-[var(--color-on-surface-variant)]">[ {category} ]</span>
	</div>
	
	<h3 class="text-xl font-bold mb-3">{title}</h3>
	
	<p class="text-sm mb-6 flex-grow leading-relaxed opacity-80">
		{body}
	</p>
	
	{techs && techs.length > 0 && (
		<div class="flex flex-wrap gap-2 mb-6">
			{techs.map((tech) => (
				<span class="bg-[var(--tech-chip-bg)] text-[var(--tech-chip-fg)] px-2 py-1 text-xs rounded-sm font-semibold font-mono">
					{tech}
				</span>
			))}
		</div>
	)}
	
	<div class="flex gap-2 mt-auto">
		{primaryBtn.enabled ? (
			<a 
				class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-2 text-sm rounded flex-1 text-center font-medium transition-colors" 
				href={primaryBtn.href}
				target={primaryBtn.href.startsWith('http') ? '_blank' : undefined}
				rel={primaryBtn.href.startsWith('http') ? 'noreferrer' : undefined}
			>
				{primaryBtn.label}
			</a>
		) : (
			<span 
				class="bg-blue-600 text-white px-3 py-2 text-sm rounded flex-1 text-center font-medium opacity-50 cursor-not-allowed select-none" 
			>
				{primaryBtn.label}
			</span>
		)}

		{!hideSecondaryAction && secondaryBtn.enabled ? (
			<a 
				class="bg-[var(--btn-secondary-bg)] hover:bg-[var(--btn-secondary-hover)] text-[var(--btn-secondary-text)] border border-[var(--border-color)] px-3 py-2 text-sm rounded flex-1 text-center font-medium transition-colors" 
				href={secondaryBtn.href}
				target={secondaryBtn.href.startsWith('http') ? '_blank' : undefined}
				rel={secondaryBtn.href.startsWith('http') ? 'noreferrer' : undefined}
			>
				{secondaryBtn.label}
			</a>
		) : !hideSecondaryAction && (
			<span 
				class="bg-[var(--btn-secondary-bg)] text-[var(--btn-secondary-text)] opacity-50 border border-[var(--border-color)]/20 px-3 py-2 text-sm rounded flex-1 text-center font-medium select-none" 
			>
				{secondaryBtn.label}
			</span>
		)}
	</div>
</article>
